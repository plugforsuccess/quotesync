# ── Supabase — Required ──────────────────────────────────────────────────────
VITE_SUPABASE_URL=<your_supabase_url>
VITE_SUPABASE_ANON_KEY=<your_supabase_anon_key>

# ── Google Places — Required for address autocomplete in wizard ───────────────
VITE_GOOGLE_PLACES_API_KEY=<your_google_places_api_key>

# ── Bland AI Inbound — Optional ───────────────────────────────────────────────
# Display number shown in the site nav/hero for direct inbound calls.
# VITE_BLAND_INBOUND_NUMBER is the formatted display version e.g. (770) 555-1234
# VITE_BLAND_INBOUND_NUMBER_E164 is the tel: href version e.g. +17705551234
# Leave blank if not using Bland inbound yet.
VITE_BLAND_INBOUND_NUMBER=
VITE_BLAND_INBOUND_NUMBER_E164=

# ── Google Ads — Optional ─────────────────────────────────────────────────────
# Conversion tracking fires on lead submission in SaveWizardPage.
VITE_GADS_CONVERSION_ID=AW-XXXXXXXXXX
VITE_GADS_CONVERSION_LABEL=<your_conversion_label>

# ── Analytics — Optional ──────────────────────────────────────────────────────
VITE_GA4_MEASUREMENT_ID=G-XXXXXXXXXX
VITE_META_PIXEL_ID=<your_pixel_id>

# ── Defensive Driving / Stripe — Edge Function secrets (server-side only) ─────
# Set these as Supabase Function secrets (NOT VITE_ vars — never expose the
# secret key to the browser). Use TEST-mode keys on staging.
#   supabase secrets set STRIPE_SECRET_KEY=sk_test_...
#   supabase secrets set STRIPE_WEBHOOK_SECRET=whsec_...
#   supabase secrets set SITE_URL=https://insuredbycam.com
# STRIPE_SECRET_KEY=sk_test_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx
# SITE_URL=https://insuredbycam.com   # base URL for Checkout success/cancel redirects

# ── Build — Auto-set by CI, leave blank locally ───────────────────────────────
# VITE_GIT_SHA=